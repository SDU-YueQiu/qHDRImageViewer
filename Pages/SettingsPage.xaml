<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HdrImageViewer.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="SettingsPage"
    Background="Transparent"
    HorizontalContentAlignment="Stretch"
    IsTabStop="True"
    PointerPressed="SettingsPage_PointerPressed"
    PointerReleased="SettingsPage_PointerReleased"
    UseSystemFocusVisuals="False"
    VerticalContentAlignment="Stretch">

    <Page.Resources>
        <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />
        <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="FocusSearchAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="32,16,32,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Glyph="&#xE721;"
                FontSize="16"
                VerticalAlignment="Center" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                AutomationProperties.AutomationId="SettingsSearchBox"
                HorizontalAlignment="Stretch"
                TextChanged="SearchBox_TextChanged"
                KeyDown="SearchBox_KeyDown" />
            <TextBlock
                x:Name="SearchHintText"
                Grid.Column="2"
                VerticalAlignment="Center"
                Opacity="0.6" />
        </Grid>

        <Grid Grid.Row="1">
            <NavigationView
                x:Name="SettingsNavigation"
                AutomationProperties.AutomationId="SettingsNavigationView"
                PaneDisplayMode="Left"
                OpenPaneLength="208"
                IsSettingsVisible="False"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                SelectionChanged="SettingsNavigation_SelectionChanged">
                <NavigationView.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <InfoBar
                            x:Name="SettingsInfoBar"
                            Grid.Row="0"
                            Margin="32,12,32,0"
                            AutomationProperties.AutomationId="SettingsInfoBar"
                            IsOpen="False"
                            IsClosable="True"
                            Visibility="{x:Bind SettingsInfoBar.IsOpen, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button
                                    x:Name="RestartNowButton"
                                    AutomationProperties.AutomationId="SettingsRestartNowButton"
                                    Click="RestartNowButton_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <ScrollViewer
                            x:Name="ContentScroller"
                            Grid.Row="1"
                            AutomationProperties.AutomationId="SettingsContentScrollViewer"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalContentAlignment="Stretch"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                x:Name="PageContentHost"
                                Padding="32,8,32,32"
                                Spacing="8"
                                HorizontalAlignment="Stretch" />
                        </ScrollViewer>
                    </Grid>
                </NavigationView.Content>
            </NavigationView>

            <Border
                x:Name="SearchResultsOverlay"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Visibility="Collapsed"
                Padding="32,8,32,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="SearchResultsHeading"
                        AutomationProperties.AutomationId="SettingsSearchResultsHeading"
                        Margin="0,0,0,8"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView
                        x:Name="SearchResultsList"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="SettingsSearchResultsList"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="SearchResultsList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
